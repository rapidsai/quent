{
  "name": "@quent/schema-viewer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/schema-viewer.css"
  },
  "sideEffects": [
    "./dist/index.js",
    "**/*.css"
  ],
  "scripts": {
    "schema:build": "pnpm --dir ../../../../crates/schema/ts build",
    "prebuild": "pnpm schema:build",
    "build": "vite build && tsc -p tsconfig.build.json",
    "precheck": "pnpm schema:build",
    "check": "svelte-check --workspace ./src --tsconfig ../tsconfig.json --config ../vite.config.ts && tsc --noEmit",
    "lint": "eslint --config ../eslint.config.js \"src/**/*.{ts,tsx}\" \"tests/**/*.ts\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@quent/schema": "link:../../../../crates/schema/ts",
    "@xyflow/svelte": "catalog:",
    "elkjs": "catalog:"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "svelte": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "8.1.5",
    "vitest": "catalog:"
  }
}
