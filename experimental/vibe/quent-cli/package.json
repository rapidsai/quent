{
  "name": "@quent-experimental/quent-cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "scripts": {
    "ask": "tsx src/ask.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm --dir ../../../ui bindings && tsc --noEmit && pnpm --filter @quent-experimental/query-diff typecheck",
    "test": "vitest run",
    "check": "pnpm format:check && pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@quent/client": "workspace:*",
    "@quent/query-analysis": "workspace:*",
    "@quent/utils": "workspace:*",
    "@quent-experimental/query-diff": "workspace:*",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-router": "catalog:",
    "ink": "^7.1.1",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "catalog:",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "catalog:",
    "vitest": "^4.1.11"
  }
}
