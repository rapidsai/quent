{
  "name": "quent-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "volta": {
    "node": "24.11.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "bindings": "cargo run --manifest-path ../Cargo.toml --package quent-query-engine-ui-bindings && pnpm bindings:format",
    "bindings:format": "vpx scripts/format-bindings.ts",
    "predev": "pnpm bindings",
    "dev": "vp dev",
    "prestart": "pnpm bindings",
    "start": "vp dev",
    "prebuild": "pnpm bindings",
    "build": "pnpm ci:build",
    "prebuild:app": "pnpm bindings",
    "build:app": "pnpm ci:build:app",
    "prebuild:packages": "pnpm bindings",
    "build:packages": "pnpm --filter '@quent/*' --recursive build:ci",
    "ci:build": "pnpm --filter '@quent/*' --recursive build:ci && pnpm ci:build:app",
    "ci:build:app": "tsr generate && vp check --no-fmt --no-lint && vp build",
    "deep-link": "vpx scripts/deep-link.ts",
    "simulator:data:clean": "node -e \"const fs=require('node:fs');const dir='../data/simulator-events';fs.rmSync(dir,{recursive:true,force:true});fs.mkdirSync(dir,{recursive:true});\"",
    "simulator:data:generate": "cargo run --manifest-path ../Cargo.toml -p quent-simulator -- --num-workloads 1 --num-queries 2 --num-workers 8 --num-threads 2 --num-gpus 1 --num-tasks 2000 --exporter collector --collector-address http://localhost:7836 --dynamic-engine-id",
    "demo:wasm": "cargo build --manifest-path ../Cargo.toml -p quent-simulator-wasm --lib --target wasm32-unknown-unknown --release --locked && wasm-bindgen ../target/wasm32-unknown-unknown/release/quent_simulator_wasm.wasm --target web --out-dir public/analyzers/simulator",
    "demo:data": "cargo run --manifest-path ../Cargo.toml -p quent-simulator-wasm --bin generate-demo --features generate --locked -- public/traces/simulator-demo.quent-browser",
    "demo:build": "pnpm demo:wasm && pnpm demo:data && pnpm bindings && tsr generate && vp check --no-fmt --no-lint && vp build --config vite.simulator.config.ts",
    "demo:dev": "pnpm demo:wasm && pnpm demo:data && pnpm bindings && vp dev --config vite.simulator.config.ts",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix",
    "format": "vp fmt .",
    "format:check": "vp fmt . --check",
    "routes:generate": "tsr generate",
    "pretypecheck": "pnpm bindings",
    "typecheck": "tsr generate && vp check --no-fmt --no-lint",
    "ci:check": "pnpm format:check && pnpm routes:generate && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm audit --audit-level=high && pnpm test:e2e && pnpm build",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:demo": "playwright test --config playwright.demo.config.ts",
    "test:e2e:simulator": "playwright test --config playwright.simulator.config.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "demo:gif": "vpx scripts/update-demo-gif.ts",
    "playwright:install": "playwright install",
    "preview": "vp preview",
    "serve": "vp preview --port 4173",
    "stats": "vp build && open stats.html"
  },
  "dependencies": {
    "@quent/client": "workspace:*",
    "@quent/components": "workspace:*",
    "@quent/hooks": "workspace:*",
    "@quent/utils": "workspace:*",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "^5.105.2",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@xyflow/react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "echarts": "catalog:",
    "echarts-for-react": "catalog:",
    "elkjs": "^0.12.1",
    "fflate": "^0.8.3",
    "jotai": "catalog:",
    "jotai-family": "catalog:",
    "lucide-react": "^1.66.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "^4.16.1",
    "tailwind-merge": "catalog:",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-vite-plugin": "^1.167.48",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vite-plus": "catalog:"
  }
}
