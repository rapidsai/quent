{
  "name": "quent-ui",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=24.11.0",
    "pnpm": ">=11.19.0"
  },
  "packageManager": "pnpm@11.19.0",
  "volta": {
    "node": "24.11.0",
    "pnpm": "11.19.0"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "bindings": "cargo run --manifest-path ../Cargo.toml --package quent-query-engine-ui-bindings && pnpm bindings:format",
    "bindings:format": "prettier --config .prettierrc --write \"generated/ts-bindings/**/*.ts\"",
    "predev": "pnpm bindings",
    "dev": "vite",
    "prestart": "pnpm bindings",
    "start": "vite",
    "prebuild": "pnpm bindings",
    "build": "pnpm ci:build",
    "prebuild:app": "pnpm bindings",
    "build:app": "pnpm ci:build:app",
    "prebuild:packages": "pnpm bindings",
    "build:packages": "pnpm --filter '@quent/*' --recursive build:ci",
    "ci:build": "pnpm --filter '@quent/*' --recursive build:ci && pnpm ci:build:app",
    "ci:build:app": "tsr generate && tsc && vite build",
    "deep-link": "tsx scripts/deep-link.ts",
    "simulator:data:clean": "node -e \"const fs=require('node:fs');const dir='../data/simulator-events';fs.rmSync(dir,{recursive:true,force:true});fs.mkdirSync(dir,{recursive:true});\"",
    "simulator:data:generate": "cargo run --manifest-path ../Cargo.toml -p quent-simulator -- --num-workloads 1 --num-queries 2 --num-workers 8 --num-threads 2 --num-gpus 1 --num-tasks 2000 --exporter collector --collector-address http://localhost:7836 --dynamic-engine-id",
    "demo:wasm": "cargo build --manifest-path ../Cargo.toml -p quent-simulator-wasm --lib --target wasm32-unknown-unknown --release --locked && wasm-bindgen ../target/wasm32-unknown-unknown/release/quent_simulator_wasm.wasm --target web --out-dir generated/simulator-wasm",
    "demo:data": "cargo run --manifest-path ../Cargo.toml -p quent-simulator-wasm --bin generate-demo --features generate --locked -- generated/simulator-demo.postcard",
    "demo:build": "pnpm demo:wasm && pnpm demo:data && pnpm bindings && tsr generate && tsc && vite build --config vite.simulator.config.ts",
    "demo:dev": "pnpm demo:wasm && pnpm demo:data && pnpm bindings && vite --config vite.simulator.config.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "routes:generate": "tsr generate",
    "pretypecheck": "pnpm bindings",
    "typecheck": "tsr generate && tsc --noEmit",
    "ci:check": "pnpm format:check && pnpm routes:generate && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm audit --audit-level=high && pnpm test:e2e && pnpm build",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "playwright:install": "playwright install",
    "preview": "vite preview",
    "serve": "vite preview --port 4173",
    "stats": "vite build && open stats.html"
  },
  "dependencies": {
    "@quent/client": "workspace:*",
    "@quent/components": "workspace:*",
    "@quent/hooks": "workspace:*",
    "@quent/utils": "workspace:*",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-navigation-menu": "^1.2.22",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@tanstack/react-query": "catalog:",
    "@tanstack/react-query-devtools": "^5.104.1",
    "@tanstack/react-router": "catalog:",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/react-table": "catalog:",
    "@tanstack/react-virtual": "catalog:",
    "@xyflow/react": "catalog:",
    "class-variance-authority": "^0.7.1",
    "clsx": "catalog:",
    "echarts": "catalog:",
    "echarts-for-react": "catalog:",
    "elkjs": "^0.12.0",
    "fflate": "^0.8.3",
    "jotai": "catalog:",
    "jotai-family": "catalog:",
    "lucide-react": "^1.52.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-resizable-panels": "^4.14.2",
    "tailwind-merge": "catalog:",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-cli": "^1.167.40",
    "@tanstack/router-vite-plugin": "^1.167.42",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "msw": "^2.15.0",
    "prettier": "^3.9.9",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tsdown": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.3",
    "vitest": "^4.1.12"
  }
}
